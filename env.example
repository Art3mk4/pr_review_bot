# ╔══════════════════════════════════════════════════════════════╗
# ║              PR Review Bot — переменные окружения            ║
# ║        Скопируй файл: cp env.example .env                   ║
# ║        Затем заполни все поля со значением CHANGE_ME         ║
# ╚══════════════════════════════════════════════════════════════╝


# ── GitHub ──────────────────────────────────────────────────────
#
# Personal Access Token для доступа к GitHub API.
# Как получить:
#   1. Перейди на https://github.com/settings/tokens
#   2. Generate new token (classic)
#   3. Отметь права: repo → read, pull_requests → write
#
GITHUB_TOKEN=CHANGE_ME


# ── Webhook Secret ───────────────────────────────────────────────
#
# Секретная строка для проверки подписи входящих webhook-запросов.
# Это же значение ты введёшь в GitHub при настройке Webhook.
# Как сгенерировать случайный секрет:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
#
WEBHOOK_SECRET=CHANGE_ME


# ── OmniRoute ───────────────────────────────────────────────────
#
# Базовый URL сервиса OmniRoute (OpenAI-совместимое API).
OMNIROUTE_BASE_URL=https://omniroute.art3mk4.site/v1
#
# API-ключ, полученный в личном кабинете OmniRoute.
OMNIROUTE_API_KEY=CHANGE_ME
#
# Модель для code review.
OMNIROUTE_MODEL=kr/qwen3-coder-next


# ── Сервер ──────────────────────────────────────────────────────
#
# Порт, на котором слушает бот внутри контейнера.
# Менять не нужно, если не конфликтует с другими сервисами.
#
PORT=8080
