# GitHub Personal Access Token (repo read + pull_requests write)
# https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Секрет для webhook — придумай сам:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=your_random_secret_here

# OmniRoute (OpenAI-совместимый API)
OMNIROUTE_BASE_URL=https://omniroute.example.com/v1
OMNIROUTE_API_KEY=your_omniroute_api_key

OMNIROUTE_MODEL=kr/qwen3-code-next
